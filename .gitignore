# Cursor IDE (local rules; do not publish)
.cursor/

# Go build cache (GOCACHE); never commit — paths look like .gocache/build/<hex>
.gocache
.gocache/

# Go module cache when GOMODCACHE is set under the repo (e.g. CI/Docker)
.gomodcache
.gomodcache/

# Workspace-local Go caches (agents/tools often set GOCACHE/GOMODCACHE here)
.cache/

# Workspace-local scratch, test binaries, and OS metadata
.tmp/
*.test
.DS_Store

data/*.sqlite
data/*.sqlite-*
data/*.bbolt
data/profile-debug/
tmp/
node_modules/
dist/
/web/static/build/
/web/static/fonts/*.woff2
/test-results/
/playwright-report/
/playwright/.cache/
# Local profiling output (pprof, runtime snapshots)
profiles/

# Local Apple signing / notarization values are never packaged or tracked.
scripts/desktop/signing.env

# Electron Forge and universal sidecar outputs.
out/
.webpack/

# Ignore any pre-clean-break generated Wails bundle left in a developer checkout.
cmd/desktop/build/
